<div class="container mx-auto p-6 bg-gray-100">
  <ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item" role="presentation">
      <a class="nav-link active" id="metrics-tab" data-toggle="tab" href="#metrics" role="tab">Metrics</a>
    </li>
    <li class="nav-item" role="presentation">
      <a class="nav-link" id="reviews-tab" data-toggle="tab" href="#reviews" role="tab">Reviews</a>
    </li>
    <li class="nav-item" role="presentation">
      <a class="nav-link" id="gallery-tab" data-toggle="tab" href="#gallery" role="tab">Gallery</a>
    </li>
    <li class="nav-item" role="presentation">
      <a class="nav-link" id="actions-tab" data-toggle="tab" href="#actions" role="tab">Actions</a>
    </li>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade show active" id="metrics" role="tabpanel">
      <%= render "metrics", company: company %>
    </div>
    <div class="tab-pane fade" id="reviews" role="tabpanel">
      <%= render "reviews", reviews: SolarReview.where(solar_company_id: company.id).limit(5) %>
    </div>
    <div class="tab-pane fade" id="gallery" role="tabpanel">
      <%= render "projects_gallery", company: company %>
    </div>
    <div class="tab-pane fade" id="actions" role="tabpanel">
      <%= render "actions", company: company %>
    </div>
  </div>
</div>

<style>
  .nav-tabs .nav-link { @apply px-4 py-2; }
  .nav-tabs .nav-link.active { @apply bg-blue-500 text-white; }
  .tab-pane { @apply p-4; }
</style>
